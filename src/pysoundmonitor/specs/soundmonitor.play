// Soundmonitor's play call. The tempo counts down once per call; out of ticks a row plays: the
// pattern's note and control bytes start a note on each voice. Between rows every voice glides,
// vibrates, sweeps its pulse width and steps its arpeggio, the filter sweeps, and the volume
// follows. A row past the pattern's length loads the next section's header; the last section
// loops or stops the song.
spec soundmonitor;

layout {
  base, freq_hi, freq_lo, first_sec, last_sec, stop_vol, vol_or, hdr_fixed, mirror: addr;
  cia, vol_imm, ramp_store: flag;
  cur: list;
  init_flag, init_row, init_section, init_playing, init_enabled, init_loop, init_mutes,
  init_tempo, init_period, init_patlen, init_ramp_len, init_ramp_ctr, init_ramp_vol, init_base_vol,
  init_vol, init_fc, init_fup, init_fdown, init_fstep, init_fbound, init_fflags: byte;
  init_tail, init_freq, init_target, init_pw, init_ctrl, init_sus, init_rate, init_limit,
  init_peak, init_mode, init_vib_dep, init_vib_per, init_vib_delay, init_vib_cnt, init_up,
  init_down, init_up_reload, init_down_reload, init_step, init_arp_on, init_arp_idx,
  init_arp_base, init_note, init_detune: list;
}

event bar: row;
event loop: bar;

cell hdr_ptr: ptr[256] @ (L.base + 0xC00, L.base + 0xD00) ro;
table instrument @ L.base + 0xE00 stride 24 {
  ctrl: u8; ad: u8; sr: u8; limit: u8; pw: u8; up: u8; down: u8; step: u8; sustain: u8;
  mode: u8; glide: u8; glide_hi: u8; vib_dep: u8; vib_per: u8; vib_delay: u8; detune: u8;
}
cell instruments: u8[0x1800] @ L.base + 0xE00 ro;
cell freq_hi: u8[256] @ L.freq_hi ro;
cell freq_lo: u8[256] @ L.freq_lo ro;
cell first_sec: u8 @ L.first_sec ro;
cell last_sec: u8 @ L.last_sec ro;
cell stop_vol: u8 @ L.stop_vol ro;
cell vol_or: u8 @ L.vol_or ro;
cell vol_mirror: u8 @ L.mirror;
cell cia_latch: u8[2] @ 0xDC04 out;
cell filt: u8[4] @ 0xD415 out;
cell sid: u8[0x18] @ 0xD400 out;

state init_flag: u8 = L.init_flag;
state row: u8 = L.init_row;
state section: u8 = L.init_section;
state playing: u8 = L.init_playing;
state enabled: u8 = L.init_enabled;
state loop_mode: u8 = L.init_loop;
state mutes: u8 = L.init_mutes;
state tempo: u8 = L.init_tempo;
state period: u8 = L.init_period;
state patlen: u8 = L.init_patlen;
state ramp_len: u8 = L.init_ramp_len;
state ramp_ctr: u8 = L.init_ramp_ctr;
state ramp_vol: u8 = L.init_ramp_vol;
state base_vol: u8 = L.init_base_vol;
state vol: u8 = L.init_vol;
state fc: u16 = L.init_fc;
state fup: u8 = L.init_fup;
state fdown: u8 = L.init_fdown;
state fstep: u8 = L.init_fstep;
state fbound: u8 = L.init_fbound;
state fflags: u8 = L.init_fflags;
state tail: u8[8] = L.init_tail;
state lap: u8 = 0;

counter beat: tempo { on frame -= 1; reload period; wrap when tempo == 0 -> row; }
counter rows: row { on row += 1; reload 0; wrap when row + 1 >= patlen -> bar; }
counter song: section { on bar += 1; reload first_sec; wrap when section == last_sec -> loop; }

handler ended on loop {
  if loop_mode != 0 {
    enabled := 0;
    finish;
  }
}

handler next_section on bar {
  load_section();
}

handler read_rows on row {
  lap := 2;
}

proc header() -> u16 {
  return ite(L.hdr_fixed != 0, L.hdr_fixed, hdr_ptr[section]);
}

proc load_section() {
  let at = header();
  stream hd = at @ 0 grammar "pysoundmonitor.grammar:GRAMMAR:section_header";
  let latch_lo = next hd;
  let latch_hi = next hd;
  if L.cia {
    cia_latch[0] := latch_lo;
    if latch_hi >= 6 {
      cia_latch[1] := latch_hi;
    }
  }
  period := next hd;
  patlen := next hd;
  let ramp = next hd;
  if ramp == 0xFF {
    ramp_len := 0;
  } elif ramp_len == 0 {
    ramp_len := ramp;
    ramp_ctr := ramp;
    ramp_vol := vol & 0x0F;
  }
  let level = next hd;
  base_vol := level & 0x0F;
  row := 0;
}

proc cutoff() {
  filt[0] := lo(fc);
  filt[1] := hi(fc);
}

proc filter_start() {
  fc := word(0, tail[2]);
  cutoff();
  fup := tail[3];
  fdown := tail[4];
  fstep := tail[5];
  fbound := tail[6];
  fflags := tail[7];
}

proc filter_down() {
  fdown -= 1;
  if hi(fc) > fbound || (fflags & 0x40) != 0 {
    fc -= word(fstep << 4, fbound);
  }
  cutoff();
}

proc filter() {
  if fup != 0 {
    fup -= 1;
    fc += word(fstep & 0xF0, fbound);
    cutoff();
  } elif fdown != 0 {
    filter_down();
  } elif (fflags & 0x10) != 0 {
    fup := tail[3];
    fdown := tail[4];
    filter_down();
  } elif (fflags & 0x20) != 0 {
    filter_start();
  }
}

proc volume() {
  if ramp_len == 0 {
    vol := (vol & 0xF0) | ite(L.vol_imm, vol_or, base_vol);
    filt[3] := vol;
    if L.mirror != 0 {
      vol_mirror := vol;
    }
    return;
  }
  ramp_ctr -= 1;
  if ramp_ctr != 0 || (ramp_vol & 0x0F) == 0 {
    return;
  }
  ramp_vol := (ramp_vol & 0x0F) - 1;
  ramp_ctr := ramp_len;
  vol := (vol & 0xF0) | ramp_vol;
  if L.ramp_store {
    filt[3] := vol;
  }
}


machine voice[x in 0..3] {
  record chip @ 0xD400 stride 7 {
    out_freq: u16; out_pw: u12; out_ctrl: u8; out_ad: u8; out_sr: u8;
  }
  cell track: ptr[256] @ (L.base + 0x400 * x, L.base + 0x400 * x + 0x100) ro;
  cell xpose: u8[256] @ L.base + 0x400 * x + 0x200 ro;
  cell ibase: u8[256] @ L.base + 0x400 * x + 0x300 ro;

  state freq: u16 = L.init_freq[x];
  state target: u16 = L.init_target[x];
  state pw: u16 = L.init_pw[x];
  state ctrl: u8 = L.init_ctrl[x];
  state sus: u8 = L.init_sus[x];
  state rate: u16 = L.init_rate[x];
  state limit: u8 = L.init_limit[x];
  state peak: u8 = L.init_peak[x];
  state mode: u8 = L.init_mode[x];
  state vib_dep: u8 = L.init_vib_dep[x];
  state vib_per: u8 = L.init_vib_per[x];
  state vib_delay: u8 = L.init_vib_delay[x];
  state vib_cnt: u8 = L.init_vib_cnt[x];
  state up: u8 = L.init_up[x];
  state down: u8 = L.init_down[x];
  state up_reload: u8 = L.init_up_reload[x];
  state down_reload: u8 = L.init_down_reload[x];
  state step: u8 = L.init_step[x];
  state arp_on: u8 = L.init_arp_on[x];
  state arp_idx: u8 = L.init_arp_idx[x];
  state arp_base: u8 = L.init_arp_base[x];
  state note: u8 = L.init_note[x];
  state detune: u8 = L.init_detune[x];
  state kicks: u8 = 0;

  proc pitch(n: u8) -> u16 {
    return word(freq_lo[n], freq_hi[n]) + u16(detune);
  }

  proc current() -> u8 {
    let f = voice[L.cur[x] >> 1].freq;
    return ite((L.cur[x] & 1) == 1, hi(f), lo(f));
  }

  proc glide_to(goal: u16) {
    let behind = freq < goal;
    let borrowed = u8(borrow(lo(freq), lo(goal)));
    let seen = current();
    let gap = ite(behind, goal - freq, word(lo(freq) - lo(goal), seen - hi(goal) - borrowed));
    if gap < rate {
      freq := goal;
      rate.lo := 0;
    } elif behind {
      freq += rate;
    } else {
      freq -= rate;
    }
    out_freq := freq;
  }

  proc glide() {
    if lo(rate) == 0 {
      return;
    }
    if (mode & 1) != 0 {
      target := word(2, limit);
    } elif (mode & 2) != 0 {
      target := word(0xFE, limit);
    }
    if (mode & 3) == 0 || (mode & 4) != 0 {
      if freq != target {
        glide_to(target);
      }
      return;
    }
    if (mode & 1) != 0 {
      if hi(freq) < limit {
        freq.hi := peak;
      }
      freq -= rate;
    } else {
      if hi(freq) >= limit {
        freq.hi := peak;
      }
      freq += rate;
    }
    out_freq := freq;
  }

  proc vibrato() {
    if vib_per == 0 {
      return;
    }
    if vib_delay != 0xFF {
      vib_delay -= 1;
      if vib_delay == 0xFF {
        vib_per &= 0xFE;
        vib_cnt := ((vib_per & 0x7F) >> 1) | (vib_per & 0x80);
      }
      return;
    }
    let rising = neg(vib_cnt);
    freq := ite(rising, freq + u16(vib_dep), freq - u16(vib_dep));
    out_freq := freq;
    vib_cnt -= 1;
    if neg(vib_cnt) != rising {
      vib_cnt := ite(rising, vib_per & 0x7F, vib_per | 0x80);
    }
  }

  proc pulse() {
    if up != 0 {
      pw += u16(step);
      out_pw := pw;
      up -= 1;
    }
    if up == 0 {
      if down != 0 {
        pw -= u16(step);
        out_pw := pw;
        down -= 1;
      } elif (mode & 0x10) != 0 {
        up := up_reload;
        down := down_reload;
      }
    }
  }

  proc arp_step() {
    if arp_on == 0 {
      return;
    }
    let at = header();
    stream hd = at @ (arp_base + arp_idx) grammar "pysoundmonitor.grammar:GRAMMAR:section_header";
    let off = hd[0];
    let f = pitch(off + note);
    f += u16(carry(off, note));
    freq := f;
    target := f;
    out_freq := f;
    arp_idx := (arp_idx + 1) & 7;
  }

  proc note_on(n: u8, c: u8) {
    let i = (c & 0x0F) + ite(neg(c), 0, ibase[section]);
    let at = u16(i) * 24;
    if instruments[at + 16] != 0xFF {
      for k in 0..8 {
        tail[k] := instruments[at + 16 + k];
      }
    }
    sus := instrument[i].sustain;
    detune := instrument[i].detune;
    note := (n & 0x7F) + ite((c & 0x20) == 0, xpose[section], 0);
    let f = pitch(note);
    if instrument[i].glide == 0 || (c & 0x10) == 0 {
      freq := f;
    }
    target := f;
    peak := hi(f);
    if !neg(n) {
      out_freq := freq;
      out_ctrl := sus;
      ctrl := sus;
      return;
    }
    arp_on := 0;
    if (c & 0x40) != 0 {
      stream before = track[section] @ ite(row == 0, (patlen << 1) - 1, (row << 1) - 1) grammar "pysoundmonitor.grammar:GRAMMAR:pattern";
      arp_base := before[0];
      arp_idx := 0;
      arp_on := 1;
      arp_step();
      for k in 0..3 {
        if k > x {
          voice[k].kicks += 1;
        }
      }
    }
    mode := instrument[i].mode;
    pw := u16(instrument[i].pw) << 4;
    up_reload := instrument[i].up;
    up := ite((mode & 0x20) != 0, 0, instrument[i].up);
    down := instrument[i].down;
    down_reload := instrument[i].down;
    rate := word(instrument[i].glide, instrument[i].glide_hi);
    limit := instrument[i].limit;
    vib_dep := instrument[i].vib_dep;
    vib_per := instrument[i].vib_per;
    vib_delay := instrument[i].vib_delay;
    step := instrument[i].step;
    out_pw := pw;
    out_ctrl := ctrl & 0xFE;
    out_ad := instrument[i].ad;
    out_sr := instrument[i].sr;
    out_freq := freq;
    if (tail[7] & (1 << x)) != 0 {
      filter_start();
    }
    out_ctrl := instrument[i].ctrl;
    if x == 1 {
      voice[0].ctrl := instrument[i].ctrl;
    } else {
      ctrl := instrument[i].ctrl;
    }
    filt[2] := tail[1];
    vol := tail[0];
  }

  proc read_row() {
    while kicks != 0 bound 3 {
      arp_step();
      kicks -= 1;
    }
    if (mutes & (1 << x)) != 0 {
      return;
    }
    stream cur = track[section] @ (row << 1) grammar "pysoundmonitor.grammar:GRAMMAR:pattern";
    match cur[0] {
      0 => {
        out_ctrl := sus;
        ctrl := sus;
      }
      0x80 => {}
      _ => note_on(cur[0], cur[1]);
    }
  }

  step {
    match lap {
      0 => {
        glide();
        vibrato();
        pulse();
        arp_step();
      }
      2 => read_row();
    }
  }
}

machine play {
  signal run: bool = false;

  proc start() {
    loop_mode := ite(init_flag == 2, 0xFF, 0);
    for i in 0..0x18 {
      sid[i] := 0;
    }
    for k in 0..3 {
      sid[7 * k + 4] := 8;
      sid[7 * k + 4] := 0;
      voice[k].freq := 0x0808;
      voice[k].target := 0x0808;
      voice[k].pw := 0x0808;
      voice[k].rate := 0x0808;
      voice[k].ctrl := 8;
      voice[k].sus := 8;
      voice[k].limit := 8;
      voice[k].peak := 8;
      voice[k].mode := 8;
      voice[k].vib_dep := 8;
      voice[k].vib_per := 8;
      voice[k].vib_delay := 8;
      voice[k].vib_cnt := 8;
      voice[k].up := 8;
      voice[k].down := 8;
      voice[k].up_reload := 8;
      voice[k].down_reload := 8;
      voice[k].step := 8;
      voice[k].arp_on := 8;
      voice[k].arp_idx := 8;
      voice[k].arp_base := 8;
      voice[k].note := 8;
      voice[k].detune := 8;
    }
    for k in 0..8 {
      tail[k] := 8;
    }
    fc := 0x0808;
    fup := 8;
    fdown := 8;
    fstep := 8;
    fbound := 8;
    fflags := 8;
    vol := 8;
    ramp_len := 8;
    ramp_ctr := 8;
    ramp_vol := 8;
    base_vol := 8;
    patlen := 8;
    period := 0;
    init_flag := 0;
    playing := 1;
    enabled := 1;
    section := first_sec;
    load_section();
    row := 0xFF;
    tempo := 7;
  }

  proc stop() {
    for k in 0..3 {
      sid[7 * k + 4] := 0;
    }
    filt[2] := 0;
    playing := 0;
    filt[3] := stop_vol;
    tempo := 7;
  }

  step {
    lap := 0;
    if init_flag != 0 {
      start();
    }
    if enabled != 0 {
      run := true;
    } elif playing != 0 {
      stop();
    }
  }
}

machine clock {
  step {
    filter();
    playing := 1;
    lap := 1;
    fire frame;
  }
}

machine mixer {
  step {
    volume();
  }
}

schedule {
  play;
  if play.run {
    for v in 0..3 {
      voice[v];
    }
    clock;
    for v in 0..3 {
      voice[v];
    }
    mixer;
  }
}
